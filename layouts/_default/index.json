[{{- range $index, $e := .Site.RegularPages -}}
  {{- if $index -}}, {{- end -}}
    {
    "title": {{ .Title | plainify | jsonify }},
    "date": {{ (.Render "date") | jsonify }},
    "description": {{ .Params.description | plainify | jsonify }},
    "body": {{ .Content | plainify | jsonify }},
    "ref": {{ .RelPermalink | plainify | jsonify }}
  }
{{- end -}}]
